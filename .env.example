# Required credentials
GEMINI_API_KEY=your-gemini-api-key
JWT_SECRET=replace-with-at-least-32-random-bytes

# PostgreSQL + pgvector is the default database. These three are required, and no
# profile variable is needed. The URL below is a local container; for Supabase use
# the Session pooler (port 5432), not the Transaction pooler (6543), and keep
# sslmode=require — Supabase endpoints refuse plain connections.
DB_URL=jdbc:postgresql://localhost:5433/ash
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Alternative: Oracle Database with Oracle Vector Search. Set all four lines to
# switch over; nothing else changes. See the README section
# "Choosing your database: PostgreSQL + pgvector or Oracle".
# Keep the names upper case: on Linux the lookup is case-sensitive.
# SPRING_PROFILES_ACTIVE=oracle
# ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# ORACLE_USERNAME=your-oracle-username
# ORACLE_PASSWORD=your-oracle-password

# Optional demo settings
DEMO_CLIENT_KEY=demo-client
DEMO_API_KEY=replace-with-a-client-api-key
DEMO_AGENT_USERNAME=your-agent-username
DEMO_AGENT_PASSWORD=your-agent-password
JWT_EXPIRATION_MS=3600000

# Generate a strong JWT secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
