# Required credentials
GEMINI_API_KEY=your-gemini-api-key
JWT_SECRET=replace-with-at-least-32-random-bytes

# Oracle is the default database. Keep these set unless you switch profiles.
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USERNAME=your-oracle-username
ORACLE_PASSWORD=your-oracle-password

# Alternative: PostgreSQL + pgvector (for example a hosted Supabase database).
# Uncomment all four lines to run the app against Postgres instead of Oracle.
# Nothing else changes; see the README section
# "Choosing your database: Oracle or PostgreSQL + pgvector".
# Use the Supabase Session pooler (port 5432), not the Transaction pooler (6543),
# and keep sslmode=require — Supabase endpoints refuse plain connections.
# SPRING_PROFILES_ACTIVE=pgvector
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your-database-password

# Optional demo settings
DEMO_CLIENT_KEY=demo-client
DEMO_API_KEY=replace-with-a-client-api-key
DEMO_AGENT_USERNAME=your-agent-username
DEMO_AGENT_PASSWORD=your-agent-password
JWT_EXPIRATION_MS=3600000

# Generate a strong JWT secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
